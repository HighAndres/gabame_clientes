# ─────────────────────────────────────────────
# Plataforma de Clientes GABAME — entorno local
# Copia a .env y ajusta. NUNCA credenciales reales aqui.
# ─────────────────────────────────────────────

# PostgreSQL (docker-compose)
POSTGRES_USER=gabame
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=clientes_gabame
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql+psycopg://gabame:cambiar_en_local@localhost:5433/clientes_gabame
SECRET_KEY=generar_con_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BACKEND_CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=local

# Email (verificacion de cuenta) — Mailhog en local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@localhost

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
EMAIL_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_MODO=smtp
# Frontend: identico a SECRET_KEY (el middleware verifica la firma del access token)
JWT_SECRET=generar_con_openssl_rand_hex_32
