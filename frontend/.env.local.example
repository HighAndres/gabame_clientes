NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=local
# Debe ser identico a SECRET_KEY del backend: el middleware verifica la firma del access token
JWT_SECRET=generar_con_openssl_rand_hex_32
# Opcional: como llama el servidor de Next al backend. En local basta la publica; en staging es http://backend:8000.
# API_URL_INTERNA=http://localhost:8000
