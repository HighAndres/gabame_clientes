# Staging para validacion del cliente. Copia a .env.staging (NO se versiona) y llena.

# Dominio base SIN www. El buzon de pruebas queda en https://<DOMINIO>/correo.
# <DOMINIO> (y www.<DOMINIO> si se usa) deben apuntar a la IP de la VPS.
DOMINIO=clientesgabame.mirmiapps.com

# 32+ bytes: openssl rand -hex 32  (mismo valor para backend y frontend)
SECRET_KEY=

# Postgres interno (no se expone)
POSTGRES_USER=gabame
POSTGRES_PASSWORD=
POSTGRES_DB=clientes_gabame

# Buzon de pruebas (https://<DOMINIO>/correo) protegido con usuario y contrasena.
# El hash se genera con: ./scripts/staging.sh hash
CORREO_USUARIO=gabame
CORREO_PASSWORD_HASH=

# Usuarios dummy (paciente, medico, partner, admins). Contrasena que tendran todos.
# Cambiala: staging queda en internet. Dejar vacio usa Local123! (solo para local).
SEED_AL_ARRANCAR=1
SEED_PASSWORD=

# Farmacias GABAME: donde vive HOY la tienda. El portal la enlaza y solo acepta enlaces a este
# host (y a los dominios del grupo), asi que moverla de dominio se hace aqui y no en el codigo.
# Mientras este en el entorno de pruebas:
# URL_FARMACIAS=https://farmaciasgabame.mirmiapps.com/es
URL_FARMACIAS=https://farmaciasgabame.com

# Correo real en vez de Mailhog (opcional). Si se llena, los testers reciben correos reales.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=no-reply@tu-dominio.com

# Solo si 80/443 ya los usa Apache/cPanel (no se toca ese servidor; ver docs/staging.md):
# PUERTO_HTTP=8080
# PUERTO_HTTPS=8443
# CADDYFILE=./deploy/Caddyfile.detras-de-apache
