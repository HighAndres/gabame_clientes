# Variante para VPS con cPanel/Apache en 80/443 que NO se toca.
# Apache termina el HTTPS (AutoSSL) y hace ProxyPass a Caddy en el puerto PUERTO_HTTP (8080).
# Caddy solo habla HTTP interno y enruta por hostname. Variables: DOMINIO, CORREO_USUARIO, CORREO_PASSWORD_HASH.

{
	auto_https off
}

http://{$DOMINIO}, http://www.{$DOMINIO} {
	encode gzip

	request_body {
		max_size 12MB
	}

	# Buzon de pruebas: los testers ven aqui sus correos. Protegido con usuario y contrasena.
	handle /correo* {
		basic_auth {
			{$CORREO_USUARIO} {$CORREO_PASSWORD_HASH}
		}
		reverse_proxy mailhog:8025
	}

	# Solo el prefijo de FastAPI: las rutas propias de Next (/api/sesion, /api/perfil, /api/backend) siguen a Next
	handle /api/v1/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
