# Proxy inverso de staging. TLS automatico con Let's Encrypt (DNS apuntando a la VPS).
# Variables: DOMINIO, CORREO_USUARIO, CORREO_PASSWORD_HASH (docker-compose.staging.yml).
#
# DNS necesarios (registros A hacia la IP de la VPS):
#   {$DOMINIO}            portal
#   www.{$DOMINIO}        redirige al portal
# El buzon de pruebas vive en https://{$DOMINIO}/correo (sin DNS extra).

www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

{$DOMINIO} {
	encode gzip

	# Documentos de partners: mismo limite que UPLOAD_MAX_MB del backend
	request_body {
		max_size 12MB
	}

	# Buzon de pruebas: los testers ven aqui sus correos. Protegido con usuario y contrasena.
	handle /correo* {
		basic_auth {
			{$CORREO_USUARIO} {$CORREO_PASSWORD_HASH}
		}
		reverse_proxy mailhog:8025
	}

	# Solo el prefijo de FastAPI: las rutas propias de Next (/api/sesion, /api/perfil, /api/backend) siguen a Next
	handle /api/v1/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
